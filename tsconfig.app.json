{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "types/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/framework/*": ["./packages/domain/src/framework/*"],
      "@/util/*": ["./packages/domain/src/util/*"],
      "@/model/*": ["./packages/domain/src/model/*"],
      "@/data/*": ["./packages/domain/src/data/*"],
      "@/templates/*": ["./packages/domain/src/templates/*"],
      "@/api/schema/*": ["./packages/domain/src/api/schema/*"],
      "@/*": ["./src/*"]
    }
  }
}
